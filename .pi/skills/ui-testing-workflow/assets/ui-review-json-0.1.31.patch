+import type { SimpleStreamOptions } from '@earendil-works/pi-ai';
+
+/** Request valid JSON from supported providers. Strict review validation is unchanged. */
+export function reviewerJsonOptions(api: string, options?: SimpleStreamOptions): SimpleStreamOptions {
+  if (!['openai-completions', 'openai-responses', 'openai-codex-responses', 'azure-openai-responses'].includes(api)) {
+    return options ?? {};
+  }
+  const original = options?.onPayload;
+  return {
+    ...options,
+    onPayload: async (payload, model) => {
+      const prepared = await original?.(payload, model) ?? payload;
+      if (!prepared || typeof prepared !== 'object' || Array.isArray(prepared)) {
+        throw new Error('Reviewer JSON mode requires an object request payload');
+      }
+      const body = prepared as Record<string, unknown>;
+      if (api === 'openai-completions') return { ...body, response_format: { type: 'json_object' } };
+      const text = body.text;
+      if (text !== undefined && (!text || typeof text !== 'object' || Array.isArray(text))) {
+        throw new Error('Reviewer JSON mode requires an object text configuration');
+      }
+      return { ...body, text: { ...(text as Record<string, unknown> | undefined), format: { type: 'json_object' } } };
+    },
+  };
+}

{
	"name": "pi-web-ui",
	"version": "0.109.0",
	"description": "Just open your browser to get all your work done — browser cockpit for AI coding agents (chat, code, files, terminal, Git in one tab)",
	"license": "MIT",
	"author": {
		"name": "xingshuyin",
		"email": "xingshuyin@users.noreply.github.com"
	},
	"type": "module",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"bin": {
		"pi-web-ui": "bin/pi-web-ui.mjs",
		"piwebui": "bin/pi-web-ui.mjs"
	},
	"main": "bin/pi-web-ui.mjs",
	"files": [
		"bin/",
		"dist/",
		"!dist/desktop",
		"web/dist/",
		"web/public/",
		"themes/",
		"deploy/",
		"extensions/",
		"plugin-sdk/",
		"plugins/catalog.json",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi",
		"pi-package",
		"coding-agent",
		"ai",
		"chat",
		"web-ui",
		"terminal",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xing-shuyin/pi-web-ui.git"
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "https://raw.githubusercontent.com/xing-shuyin/pi-web-ui/main/assets/chat-prompts.jpeg"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
		"dev:server": "cross-env PI_WEB_PORT=8788 PI_WEB_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 node --watch --import tsx server/index.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"build": "npm run build:web && npm run build:server && npm run build:dsh-runtime",
		"build:web": "vite build --config web/vite.config.ts",
		"build:server": "tsc -p tsconfig.server.json",
		"build:dsh-runtime": "node scripts/copy-dsh-runtime.mjs",
		"build:mermaid-vendor": "node scripts/build-mermaid-vendor.mjs",
		"build:extension": "node plugins/page-picker/extension/build.mjs",
		"pack:extension": "node plugins/page-picker/extension/pack.mjs",
		"build:runtrace-vendor": "node scripts/build-runtrace-vendor.mjs",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p desktop/tsconfig.json --noEmit && tsc -p plugins/page-picker/extension/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run",
		"clean": "node scripts/clean-project.mjs",
		"clean:apply": "node scripts/clean-project.mjs --apply",
		"ui-testing:enable": "node scripts/enable-ui-testing.mjs",
		"test:ui:integration": "node tests/ui-testing-integration-test.mjs",
		"test:ui:guards": "node tests/ui-tool-guards-test.mjs",
		"test:ui:fixture": "node tests/ui-project-fixture-test.mjs",
		"test:ui:project": "node tests/ui-project-browser-test.mjs",
		"test:agent-evaluation:watermate": "node tests/watermate-ec14-gui-test.mjs",
		"test:smoke": "node tests/run-smoke.mjs",
		"test:smoke:core": "node tests/run-smoke.mjs --core",
		"check:protocol": "node scripts/check-protocol-sync.mjs",
		"i18n:diff": "node scripts/i18n-diff.mjs",
		"i18n:check": "node scripts/i18n-diff.mjs --check-packs",
		"release:notes": "node scripts/release-notes.mjs",
		"changelog:i18n": "node scripts/release-notes.mjs --unreleased",
		"test:freeze": "node tests/freeze-test.mjs",
		"plugins:link": "node scripts/link-plugins.mjs",
		"plugins:unlink": "node scripts/link-plugins.mjs --unlink",
		"start": "node --import ./dist/server/resolve-global-sdk.js dist/server/index.js",
		"build:desktop": "tsc -p desktop/tsconfig.json",
		"desktop:dev": "npm run build:desktop && node scripts/run-profile.mjs desktop electron dist/desktop/main.js",
		"desktop:dist": "npm run build && npm run build:desktop && npm run desktop:package",
		"desktop:portable": "npm run build && npm run build:desktop && node scripts/make-portable.mjs",
		"desktop:portable:full": "npm run build && npm run build:desktop && node scripts/make-portable.mjs --with-git",
		"format": "prettier --write server/ web/src/ extensions/ scripts/ bin/ desktop/ tests/*.mjs tests/unit/ *.mjs",
		"format:check": "prettier --check server/ web/src/ extensions/ scripts/ bin/ desktop/ tests/*.mjs tests/unit/ *.mjs",
		"lint": "oxlint server/ web/src/ extensions/ scripts/ bin/ desktop/",
		"lint:fix": "oxlint --fix server/ web/src/ extensions/ scripts/ bin/ desktop/",
		"api-testing:enable": "node scripts/enable-api-testing.mjs",
		"data-space:enable": "node scripts/enable-data-space.mjs",
		"agent-evaluation:enable": "node scripts/enable-agent-evaluation.mjs",
		"agent-evaluation:enroll-runtime": "node scripts/enroll-agent-evaluation-runtime.mjs",
		"test:data-space:native": "node --import tsx tests/data-space-native-test.mjs",
		"test:data-space:browser": "node --import tsx tests/data-space-browser-test.mjs",
		"test:api:visibility": "node --import tsx tests/api-testing-visibility-test.mjs",
		"build:vendor": "npm run build:mermaid-vendor && npm run build:runtrace-vendor",
		"install:desktop": "node scripts/install-profile.mjs desktop",
		"install:vendor": "node scripts/install-profile.mjs vendor",
		"install:e2e": "node scripts/install-profile.mjs e2e",
		"install:api-tests": "npm ci --prefix plugins/api-testing --no-audit --no-fund",
		"desktop:package": "node scripts/run-profile.mjs desktop electron-builder -c desktop/electron-builder.yml",
		"typecheck:core": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p plugins/page-picker/extension/tsconfig.json --noEmit",
		"typecheck:desktop": "tsc -p desktop/tsconfig.json --noEmit",
		"size:report": "node scripts/project-budget.mjs",
		"size:check": "node scripts/project-budget.mjs --check"
	},
	"dependencies": {
		"@deepseek-ai/cordis": "4.0.2",
		"@deepseek-ai/dsh-anonymous-user-id": "0.1.5-rc.3",
		"@deepseek-ai/dsh-atomic-write": "0.1.5-rc.3",
		"@deepseek-ai/dsh-attachment": "0.1.5-rc.3",
		"@deepseek-ai/dsh-credentials": "0.1.5-rc.3",
		"@deepseek-ai/dsh-home-paths": "0.1.5-rc.3",
		"@deepseek-ai/dsh-launch-environment": "0.1.5-rc.3",
		"@deepseek-ai/dsh-llm": "0.1.5-rc.3",
		"@deepseek-ai/dsh-llm-deepseek": "0.1.5-rc.3",
		"@deepseek-ai/dsh-scope": "0.1.5-rc.3",
		"@deepseek-ai/dsh-sdk-jsonrpc-server": "^0.1.5-rc.3",
		"@deepseek-ai/dsh-sdk-protocol": "^0.1.5-rc.3",
		"@deepseek-ai/dsh-tools": "0.1.5-rc.3",
		"compression": "^1.8.2",
		"electron-updater": "^6.8.9",
		"express": "^5.2.1",
		"node-pty": "^1.1.0",
		"ssh2": "^1.17.0",
		"tar": "^7.5.22",
		"undici": "^8.9.0",
		"ws": "^8.21.3",
		"yauzl": "^3.4.0"
	},
	"optionalDependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0",
		"typebox": "1.3.27"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.2.0",
		"@earendil-works/pi-ai": "1.2.0",
		"@earendil-works/pi-codemode": "1.2.0",
		"@earendil-works/pi-mcp": "1.2.0",
		"@earendil-works/pi-telemetry": "1.2.0",
		"@earendil-works/pi-tui": "1.2.0",
		"@types/compression": "^1.8.1",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/ssh2": "^1.15.6",
		"@types/ws": "^8.18.1",
		"@types/yauzl": "^3.4.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"esbuild": "^0.28.2",
		"highlight.js": "^11.12.0",
		"html-to-image": "^1.11.13",
		"jsdom": "^30.1.0",
		"katex": "^0.18.7",
		"oxlint": "^1.83.0",
		"prettier": "^3.9.8",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"allowScripts": {
		"node-pty@1.1.0": true
	}
}
